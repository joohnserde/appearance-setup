<?xml version="1.0" encoding="UTF-8"?>

<openbox_menu xmlns="http://openbox.org/3.4/menu">

<menu id="apps-ide-menu" label="Code Editors">
  <item label="Android Studio">
    <action name="Execute">
      <command>/opt/android-studio/bin/studio</command>
      <startupnotify>
        <enabled>yes</enabled>
      </startupnotify>
    </action>
  </item>
  <item label="InteleJIDE">
    <action name="Execute">
      <command>/opt/idea-IC/bin/idea</command>
      <startupnotify>
        <enabled>yes</enabled>
      </startupnotify>
    </action>
  </item>
  <item label="Clion">
    <action name="Execute">
      <command>/opt/clion/bin/clion</command>
    </action>
  </item> 
  <item label="RustRover">
    <action name="Execute">
      <command>/opt/RustRover/bin/rustrover</command> 
      <startupnotify>
        <enabled>yes</enabled>
      </startupnotify>
    </action>
  </item>
  <item label="Visual Studio">
    <action name="Execute">
      <command>code</command>
      <startupnotify>
        <enabled>yes</enabled>
      </startupnotify>
    </action>
  </item>
</menu>
<menu id="apps-database-client-menu" label="Database Client">
  <item label="DataGrip">
    <action name="Execute">
      <command>/opt/DataGrip/bin/datagrip</command>
    </action>
  </item>
</menu>
<menu id="apps-git-client-menu" label="Git Client">
  <item label="GitKraken">
    <action name="Execute">
      <command>/opt/gitkraken/gitkraken</command>
    </action>
  </item>
</menu>
